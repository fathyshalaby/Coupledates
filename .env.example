# Couple Dates - environment variables
#
# Copy to .env.local for local work, or add these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values. Anything named VITE_* is baked into the public web bundle at BUILD time,
# so it must be set before the build runs (changing it requires a redeploy).

# --- Required: the app does not work without these -------------------------------------------------

# PostgreSQL. On Vercel use a pooled connection string (Neon: the "-pooler" host) so serverless
# instances do not exhaust connections. Create the tables once with:
#   DATABASE_URL=... pnpm --filter @workspace/db run push
DATABASE_URL=

# Clerk authentication. Use a DEVELOPMENT instance (pk_test_/sk_test_) for *.vercel.app and preview
# URLs. A production instance (pk_live_) only works on a custom domain with Clerk's DNS records,
# because the app derives the Clerk frontend host from the request host (clerk.<your-domain>).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Long random string. Encrypts stored Whop webhook secrets and signs account-recovery codes.
# Keep it stable: rotating it breaks webhook verification until billing is re-provisioned.
SESSION_SECRET=

# --- Required for photo uploads ---------------------------------------------------------------------

# Private Google Cloud Storage location as /<bucket>/<folder>. Bucket CORS must allow PUT from the
# app origin with the Content-Type header, and the bucket must NOT be public.
PRIVATE_OBJECT_DIR=
# Service-account key (JSON, or base64 of the JSON) with read/write on that bucket.
# Leave unset only on Replit, where the built-in storage sidecar is used instead.
GCS_CREDENTIALS_JSON=

# --- Required for the paid Plus plan (checkout returns 503 until set) -------------------------------

WHOP_API_KEY=
# Replit's currently configured values live in .replit ([userenv.shared]); reuse them or create new ones.
WHOP_COMPANY_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID=
# The exact HTTPS origin users reach the app on, no path or trailing slash (e.g. https://app.example.com).
# Used for the Whop webhook URL AND to authorise account-recovery POSTs, so on a test deployment it must
# equal that deployment's own URL.
BILLING_APP_ORIGIN=

# --- Required for the AI date assistant (only that feature fails if unset) --------------------------

AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=

# --- Optional ---------------------------------------------------------------------------------------

# pino level: trace | debug | info | warn | error. Defaults to info.
LOG_LEVEL=

# --- Replit only: do NOT set on Vercel --------------------------------------------------------------
# PORT, BASE_PATH              set by Replit artifacts (vercel.json supplies build-time values)
# VITE_CLERK_PROXY_URL         Replit's Clerk proxy; leave unset elsewhere
# REPLIT_CONNECTORS_HOSTNAME, REPL_IDENTITY, WEB_REPL_RENEWAL
#                              Whop key lookup when WHOP_API_KEY is unset
