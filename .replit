modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "billing-contract"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ui-layout-regression"

[[workflows.workflow]]
name = "billing-contract"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:billing-contract"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ui-layout-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/couple-dates run test:ui:types && pnpm --filter @workspace/couple-dates run test:ui"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_OeXP5gWMjWn4bc"
WHOP_PLAN_ID = "plan_UyyHS7aVjOJKS"
WHOP_PRODUCT_ID = "prod_6JNasCIzQVIZi"

[userenv.development]
BILLING_APP_ORIGIN = "https://47847380-6335-4a4d-9967-42da2a382a6b-00-391sg7ngokwfm.janeway.replit.dev"

[userenv.production]
BILLING_APP_ORIGIN = "https://couple-dates.replit.app"
PUBLIC_SITE_URL = "https://couple-dates.replit.app"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 24383
externalPort = 80
